# {{ ansible_managed }}
{% for v in lvm_volumes | sort(attribute='mount') %}
/dev/{{ lvm_vg_name }}/{{ v.name }}	{{ v.mount }}	{{ v.fstype }}	{{ v.options }}	0	{{ 1 if v.mount == '/' else 2 }}
{% endfor %}
UUID={{ lvm_boot_uuid }}	/boot	ext4	defaults,nodev,nosuid,noexec	0	2
UUID={{ lvm_esp_uuid }}	/boot/efi	vfat	umask=0077,shortname=winnt,nodev,nosuid,noexec	0	1
