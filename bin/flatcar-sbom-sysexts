#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(
  cd -- "$(dirname "$0")" >/dev/null 2>&1
  pwd -P
)/.."

cat <<EOF >~/.s3cfg
host_base = ${S3_HOST}
host_bucket = ${S3_HOST}
access_key = ${S3_ACCESS_KEY}
secret_key = ${S3_SECRET_KEY}
use_https = True
signurl_use_https = True
EOF

manifest="${REPO_ROOT}/vars/flatcar/sysext-manifest.json"

process_sysext() {
  local type="$1"
  local version="$2"
  local tag="$3"
  local s3_sbom_key="flatcar/sysexts/${tag}-sbom.json"
  local s3_bundle_key="flatcar/sysexts/${tag}.cosign.bundle"
  local sbom_url bundle_url tmpdir

  if [[ "${FORCE_PUSH:-false}" != "true" ]] &&
    s3cmd info "s3://${S3_BUCKET}/${s3_sbom_key}" >/dev/null 2>&1; then
    echo "${tag}: SBOM already in S3, skipping"
    sbom_url="${S3_HOST_PUBLIC_PATH}/${s3_sbom_key}"
    bundle_url="${S3_HOST_PUBLIC_PATH}/${s3_bundle_key}"
  else
    if [[ ! -f "${tag}.raw" ]]; then
      s3cmd get "s3://${S3_BUCKET}/flatcar/sysexts/${tag}.raw" "${tag}.raw"
    fi

    tmpdir=$(mktemp -d)
    unsquashfs -d "${tmpdir}" "${tag}.raw"
    syft "${tmpdir}" -o syft-json >"${tag}-sbom.json"
    rm -rf "${tmpdir}"

    cosign sign-blob "${tag}.raw" --bundle "${tag}.cosign.bundle" -y

    s3cmd put "${tag}-sbom.json" "s3://${S3_BUCKET}/${s3_sbom_key}"
    s3cmd put "${tag}.cosign.bundle" "s3://${S3_BUCKET}/${s3_bundle_key}"

    sbom_url="${S3_HOST_PUBLIC_PATH}/${s3_sbom_key}"
    bundle_url="${S3_HOST_PUBLIC_PATH}/${s3_bundle_key}"

    rm -f "${tag}-sbom.json" "${tag}.cosign.bundle" "${tag}.raw"
  fi

  jq \
    --arg type "${type}" \
    --arg version "${version}" \
    --arg sbom_url "${sbom_url}" \
    --arg bundle_url "${bundle_url}" \
    '.[$type][$version].sbom_url = $sbom_url | .[$type][$version].cosign_bundle_url = $bundle_url' \
    "${manifest}" >/tmp/sysext-manifest.json
  mv /tmp/sysext-manifest.json "${manifest}"
}

while IFS=: read -r type version tag; do
  process_sysext "${type}" "${version}" "${tag}"
done < <(jq -r '
  to_entries[] |
  .key as $type |
  .value | to_entries[] |
  [$type, .key, .value.tag] |
  join(":")
' "${manifest}")

echo "Updated sysext-manifest.json:"
cat "${manifest}"
