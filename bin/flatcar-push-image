#!/usr/bin/env bash

set -euxo pipefail

cat <<EOF >~/.s3cfg
host_base = ${S3_HOST}
host_bucket = ${S3_HOST}
access_key = ${S3_ACCESS_KEY}
secret_key = ${S3_SECRET_KEY}
use_https = True
signurl_use_https = True
EOF

image_name="flatcar-stable-${FLATCAR_VERSION}.img"
s3_key="flatcar/${image_name}"
image_url="${S3_HOST_PUBLIC_PATH}/${s3_key}"

curl -fSL \
  "https://stable.release.flatcar-linux.net/amd64-usr/${FLATCAR_VERSION}/flatcar_production_openstack_image.img.bz2" \
  -o flatcar_production_openstack_image.img.bz2

bunzip2 flatcar_production_openstack_image.img.bz2
mv flatcar_production_openstack_image.img "${image_name}"

s3cmd put "${image_name}" "s3://${S3_BUCKET}/${s3_key}"
rm -f "${image_name}"

echo "image-url=${image_url}" >>"${GITHUB_OUTPUT:-/dev/stdout}"
