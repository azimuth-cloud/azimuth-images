#!/usr/bin/env python3

import json
import os
import pathlib

from ruamel.yaml import YAML

repo_root = pathlib.Path(__file__).parent.parent.resolve()

# Read the builds from the YAML file
with open(repo_root / ".github" / "builds.yaml", "r") as fh:
    builds = YAML(typ="safe").load(fh)

# Output the builds as JSON
has_ubuntu = any(
    any(vf.strip().startswith("ubuntu-") for vf in build.get("var-files", "").split(","))
    for build in builds
)
output_path = os.environ.get("GITHUB_OUTPUT", "/dev/stdout")
with open(output_path, "a") as fh:
    print(f"builds={json.dumps(builds)}", file=fh)
    print(f"has_ubuntu_builds={'true' if has_ubuntu else 'false'}", file=fh)
