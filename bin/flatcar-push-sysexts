#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(
  cd -- "$(dirname "$0")" >/dev/null 2>&1
  pwd -P
)/.."

cat <<EOF >~/.s3cfg
host_base = ${S3_HOST}
host_bucket = ${S3_HOST}
access_key = ${S3_ACCESS_KEY}
secret_key = ${S3_SECRET_KEY}
use_https = True
signurl_use_https = True
EOF

checksums_file=$(mktemp)

push_sysext() {
  local tag="$1"
  local bakery_release="$2"
  local s3_key="flatcar/sysexts/${tag}.raw"

  if [[ "${FORCE_PUSH:-false}" != "true" ]] &&
    s3cmd info "s3://${S3_BUCKET}/${s3_key}" >/dev/null 2>&1; then
    echo "${s3_key}: already in S3, skipping upload"
    # Reuse checksum from existing manifest entry if available
    local existing
    existing=$(jq -r \
      --arg t "${tag}" \
      '[.containerd, .kubernetes] | map(to_entries[] | select(.value.tag == $t) | .value.checksum) | first // empty' \
      "${REPO_ROOT}/vars/flatcar/sysext-manifest.json")
    if [[ -n "${existing}" ]]; then
      echo "${tag}=${existing}" >>"${checksums_file}"
      return
    fi
    # No existing checksum: download to compute it
    s3cmd get "s3://${S3_BUCKET}/${s3_key}" "${tag}.raw"
  else
    gh release download "${bakery_release}" \
      --repo flatcar/sysext-bakery \
      --pattern "${tag}.raw" \
      --pattern "SHA256SUMS" \
      --clobber
    grep "^[0-9a-f]\{64\}  ${tag}\.raw$" SHA256SUMS | sha256sum -c -
    s3cmd put "${tag}.raw" "s3://${S3_BUCKET}/${s3_key}"
  fi

  echo "${tag}=sha256-$(sha256sum "${tag}.raw" | awk '{print $1}')" >>"${checksums_file}"
  rm -f "${tag}.raw" SHA256SUMS
}

containerd_version=$(jq -r '.containerd_version' "${REPO_ROOT}/vars/flatcar/versions.json")
containerd_tag="containerd-${containerd_version}-x86-64"
push_sysext "${containerd_tag}" "containerd-${containerd_version}"

k8s_versions=$(
  jq -rs '[.[] | .kubernetes_semver] | join(" ")' \
    "${REPO_ROOT}"/vars/base/kubernetes_1_*.json
)
for semver in ${k8s_versions}; do
  k8s_tag="kubernetes-${semver}-x86-64"
  push_sysext "${k8s_tag}" "${k8s_tag%-x86-64}"
done

# Build sysext-manifest.json from collected checksums
manifest=$(jq -n '{containerd: {}, kubernetes: {}}')

containerd_checksum=$(grep "^${containerd_tag}=" "${checksums_file}" | cut -d= -f2-)
manifest=$(echo "${manifest}" | jq \
  --arg version "${containerd_version}" \
  --arg tag "${containerd_tag}" \
  --arg url "${S3_HOST_PUBLIC_PATH}/flatcar/sysexts/${containerd_tag}.raw" \
  --arg checksum "${containerd_checksum}" \
  '.containerd[$version] = {tag: $tag, url: $url, checksum: $checksum}')

for semver in ${k8s_versions}; do
  k8s_tag="kubernetes-${semver}-x86-64"
  k8s_checksum=$(grep "^${k8s_tag}=" "${checksums_file}" | cut -d= -f2-)
  manifest=$(echo "${manifest}" | jq \
    --arg semver "${semver}" \
    --arg tag "${k8s_tag}" \
    --arg url "${S3_HOST_PUBLIC_PATH}/flatcar/sysexts/${k8s_tag}.raw" \
    --arg checksum "${k8s_checksum}" \
    '.kubernetes[$semver] = {tag: $tag, url: $url, checksum: $checksum}')
done

echo "${manifest}" | jq '.' >"${REPO_ROOT}/vars/flatcar/sysext-manifest.json"
cat "${REPO_ROOT}/vars/flatcar/sysext-manifest.json"
